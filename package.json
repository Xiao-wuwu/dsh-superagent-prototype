{
  "name": "@reserendipity/dsh-superagent",
  "author": {
    "name": "Xiao-wuwu",
    "url": "https://github.com/Xiao-wuwu"
  },
  "license": "MIT",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "（非官方产品）本地优先的 Super-agent：在官方 dsh-superagent-prototype 与其 Windows 适配版之上，加入真事件文件监听（file.created/changed/renamed/deleted 四种同形信号）与经验库（ReActive：信号来了先查经验再思考行动）。默认 local 模式，不配 GitHub 也能跑。上游 https://github.com/deepseek-ai/dsh-superagent-prototype（MIT, Copyright (c) 2026 DeepSeek Harness Team）；Windows 适配 https://github.com/ReSerendipity/dsh-superagent；本分支 https://github.com/Xiao-wuwu/dsh-superagent-prototype",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./github-watch": "./lib/github-watch.js",
    "./feishu-watch": "./lib/feishu-watch.js",
    "./inbox-watch": "./lib/inbox-watch.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./filewatch-watch": "./lib/filewatch-watch.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "NOTICE",
    "examples",
    "prompts",
    "skills",
    "schema"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "release:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-check.ps1",
    "pack:plugin": "node scripts/pack-plugin.mjs",
    "prepack": "pnpm build",
    "experience": "node scripts/experience.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-alpha.2 <0.3.0"
  },
  "packageManager": "pnpm@11.7.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5-alpha.1 <5",
    "@deepseek-ai/dsh-agent": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-permission-presets": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-scope": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-workspace": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.5-alpha.1 <4",
    "@deepseek-ai/dsh-skill": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-attachment": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.1-alpha.2 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-permission-presets": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-settings": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-workspace": "0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@types/jsdom": "28.0.3",
    "@types/node": "22.20.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "18.3.28",
    "jsdom": "29.1.1",
    "react": "18.3.1",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.8",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.2",
    "react-dom": "18.3.1",
    "@types/react-dom": "18.3.7",
    "@deepseek-ai/dsh-subprocess": "0.2.1-alpha.2",
    "proper-lockfile": "4.1.2",
    "zod": "4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xiao-wuwu/dsh-superagent-prototype.git"
  },
  "homepage": "https://github.com/Xiao-wuwu/dsh-superagent-prototype/tree/local-filewatch",
  "bugs": {
    "url": "https://github.com/ReSerendipity/dsh-superagent/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "super-agent",
    "github",
    "windows"
  ],
  "contributors": [
    {
      "name": "DeepSeek Harness Team",
      "url": "https://github.com/deepseek-ai/dsh-superagent-prototype"
    },
    {
      "name": "ReSerendipity (Windows adaptation)",
