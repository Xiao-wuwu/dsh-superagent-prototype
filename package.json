{
  "name": "@reserendipity/dsh-superagent",
  "author": {
    "name": "ReSerendipity",
    "url": "https://github.com/ReSerendipity"
  },
  "license": "MIT",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "（非官方产品）DSH-Superagent 是 DeepSeek Harness 的插件：把 GitHub 仓库（issue/PR/评论/CI）、本机收件目录或可选的飞书群聊事件，变成在上下文隔离的 DSH 会话里执行的工单，并把结果回贴原处；面板管触发、评估、执行与设置。可直接装进官方 DeepSeek Harness 应用（无需第二个程序），也支持完全不配 GitHub 的本地模式；作为官方 dsh-superagent-prototype 的 Windows 适配版（非官方产品），补齐了上游未实现的 Watchdog 控制回路与 Router 分片。上游：https://github.com/deepseek-ai/dsh-superagent-prototype（MIT，Copyright (c) 2026 DeepSeek Harness Team）；本构建：https://github.com/ReSerendipity/dsh-superagent",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./github-watch": "./lib/github-watch.js",
    "./feishu-watch": "./lib/feishu-watch.js",
    "./inbox-watch": "./lib/inbox-watch.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "NOTICE",
    "examples",
    "prompts",
    "skills",
    "schema"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "release:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-check.ps1",
    "pack:plugin": "node scripts/pack-plugin.mjs",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-alpha.2 <0.3.0"
  },
  "packageManager": "pnpm@11.7.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-alpha.2 <0.3.0",
