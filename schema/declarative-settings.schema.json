{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ReSerendipity/dsh-superagent/schema/declarative-settings.schema.json",
  "title": "DSH-Superagent declarative settings",
  "description": "A settings file the runtime overlays on the stored settings at startup (and again on every save). Every block is optional: an omitted block keeps what the panel stored, so a file may declare only the part a team owns. `sources` and `policy` merge key by key; other blocks replace whole.",
  "type": "object",
  "properties": {
    "paused": {
      "default": false,
      "type": "boolean"
    },
    "sources": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "enabled": {
            "default": true,
            "type": "boolean"
          },
          "config": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "additionalProperties": false
      }
    },
    "policy": {
      "default": {
        "rules": [
          {
            "id": "copy",
            "name": "Copy fixes",
            "enabled": true,
            "instruction": "Explicit requests to correct a typo, wording, punctuation or existing translation. Preserve product promises and business meaning."
          },
          {
            "id": "visual",
            "name": "Visual fixes",
            "enabled": true,
            "instruction": "Explicit implementation requests for local spacing, alignment, overflow or styling, with a specified target or an objectively established existing standard/correct state to restore. Locating an element or calling it inconsistent, unattractive or hard to understand does not establish a target. Do not invent visual style, information hierarchy, rendering or interaction decisions. No redesign, new interaction or behavior. A known spacing defect does not authorize adjacent undefined restyling; assess only a clearly separable authorized scope. If direction or scope is unsettled, observe only: no acknowledgement, worker or unsolicited question."
          }
        ],
        "sources": {}
      },
      "type": "object",
      "properties": {
        "rules": {
          "default": [
            {
              "id": "copy",
              "name": "Copy fixes",
              "enabled": true,
              "instruction": "Explicit requests to correct a typo, wording, punctuation or existing translation. Preserve product promises and business meaning."
            },
            {
              "id": "visual",
              "name": "Visual fixes",
              "enabled": true,
              "instruction": "Explicit implementation requests for local spacing, alignment, overflow or styling, with a specified target or an objectively established existing standard/correct state to restore. Locating an element or calling it inconsistent, unattractive or hard to understand does not establish a target. Do not invent visual style, information hierarchy, rendering or interaction decisions. No redesign, new interaction or behavior. A known spacing defect does not authorize adjacent undefined restyling; assess only a clearly separable authorized scope. If direction or scope is unsettled, observe only: no acknowledgement, worker or unsolicited question."
            }
          ],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,80}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "enabled": {
                "type": "boolean"
              },
              "instruction": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "id",
              "name",
              "enabled",
              "instruction"
            ],
            "additionalProperties": false
          }
        },
        "sources": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "allowed": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "name": {
                      "type": "string",
                      "maxLength": 100
                    }
                  },
                  "required": [
                    "id"
                  ],
                  "additionalProperties": false
                }
              },
              "admission": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "listedUnaddressed": {
                      "type": "string",
                      "enum": [
                        "inferred",
                        "ignore"
                      ]
                    },
                    "unlistedAddressed": {
                      "type": "string",
                      "enum": [
                        "explicit",
                        "inferred",
                        "ignore"
                      ]
                    },
                    "unlistedUnaddressed": {
                      "type": "string",
                      "enum": [
                        "inferred",
                        "ignore"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": {}
          }
        }
      },
      "additionalProperties": false
    },
    "eval": {
      "default": {
        "mode": "observe",
        "timeoutSeconds": 300,
        "model": null
      },
      "type": "object",
      "properties": {
        "mode": {
          "default": "observe",
          "type": "string",
          "enum": [
            "off",
            "observe",
            "auto"
          ]
        },
        "timeoutSeconds": {
          "default": 300,
          "type": "integer",
          "minimum": 30,
          "maximum": 600
        },
        "model": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "reasoningEffort": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "provider",
                "model"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "executor": {
      "default": {
        "model": null,
        "maxWorkers": 3,
        "directory": "",
        "prepare": "",
        "blockedCommands": [],
        "watchdogMinutes": 30,
        "watchdogStallMinutes": 45,
        "watchdogGuidance": "",
        "routerShards": 1
      },
      "type": "object",
      "properties": {
        "model": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "reasoningEffort": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "provider",
                "model"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "maxWorkers": {
          "default": 3,
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "directory": {
          "default": "",
          "type": "string"
        },
        "prepare": {
          "default": "",
          "type": "string",
          "maxLength": 4000
        },
        "blockedCommands": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          }
        },
        "watchdogMinutes": {
          "default": 30,
          "type": "integer",
          "minimum": 0,
          "maximum": 1440
        },
        "watchdogStallMinutes": {
          "default": 45,
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "watchdogGuidance": {
          "default": "",
          "type": "string",
          "maxLength": 2000
        },
        "routerShards": {
          "default": 1,
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      },
      "additionalProperties": false
    },
    "chatRouter": {
      "default": {
        "enabled": false,
        "scope": "allNewChats",
        "tools": {
          "preset": "standard",
          "allow": []
        },
        "forceDispatch": true,
        "worker": {
          "preset": "standard",
          "maxParallel": 3
        },
        "reply": {
          "mode": "brief",
          "onProgress": false
        }
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "scope": {
          "default": "allNewChats",
          "type": "string",
          "enum": [
            "allNewChats"
          ]
        },
        "tools": {
          "default": {
            "preset": "standard",
            "allow": []
          },
          "type": "object",
          "properties": {
            "preset": {
              "default": "standard",
              "type": "string",
              "enum": [
                "strict",
                "standard",
                "custom"
              ]
            },
            "allow": {
              "default": [],
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          }
        },
        "forceDispatch": {
          "default": true,
          "type": "boolean"
        },
        "worker": {
          "default": {
            "preset": "standard",
            "maxParallel": 3
          },
          "type": "object",
          "properties": {
            "preset": {
              "default": "standard",
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "maxParallel": {
              "default": 3,
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            }
          }
        },
        "reply": {
          "default": {
            "mode": "brief",
            "onProgress": false
          },
          "type": "object",
          "properties": {
            "mode": {
              "default": "brief",
              "type": "string",
              "enum": [
                "brief",
                "none"
              ]
            },
            "onProgress": {
              "default": false,
              "type": "boolean"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "$prune": {
      "type": "object",
      "description": "Names stored items the file must delete before the declared blocks merge. Without it a file could only add and override, so a Source an earlier file declared could never be removed.",
      "properties": {
        "sources": {
          "type": "array",
          "description": "Source ids to delete before merging; an undeclared id fails validation.",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
