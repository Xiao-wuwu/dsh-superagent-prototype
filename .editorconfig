# EditorConfig — project-wide coding style
# https://editorconfig.org
#
# 本文件由 ReSerendipity/.github 的 governance/templates/editorconfig.template 派生（§12.5 条款 1：既有文件不覆盖，缺失才补）。
# 与 .gitattributes 的 eol=lf 同口径；本仓在 Windows 上开发，工作副本可能是 CRLF，入库必须归一为 LF。

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
indent_size = 4

[*.{js,ts,tsx,jsx,json,yml,yaml,html,css,scss,vue}]
indent_size = 2

[*.rs]
indent_size = 4

[*.{kt,kts}]
indent_size = 4

[*.md]
# markdown 行尾两空格是硬换行语法，不能去
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
